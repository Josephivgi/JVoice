{
  "name": "jvoice",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "Josephivgi",
  "description": "JVoice: hold a shortcut, talk, and get clean text typed into any app. Speech to text with ElevenLabs Scribe and optional AI cleanup, all through your OpenRouter key.",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test test/*.test.cjs",
    "icon": "node scripts/make-icon.cjs",
    "dist": "electron-builder --win",
    "release": "node scripts/release.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.4",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.josephivgi.jvoice",
    "productName": "JVoice",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "assets/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "JVoice-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Josephivgi",
        "repo": "JVoice",
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Josephivgi/JVoice.git"
  }
}
